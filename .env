# ─── ASTRALEARNIA ENVIRONMENT VARIABLES ──────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Email (SMTP) Configuration ────────────────────────────────────────────────
# Required for the contact form to send emails.
# Recommended: Gmail with App Password, Brevo (free 300/day), or Resend.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                         # Set to true if using port 465

# Your SENDING email address (the "from" address)
SMTP_USER=hello@astralearnia.com

# Gmail: generate an App Password at myaccount.google.com/apppasswords
# Brevo: use your SMTP key from app.brevo.com/settings/keys/smtp
SMTP_PASS=your-app-password-here

# Where contact form submissions get DELIVERED (your inbox)
CONTACT_TO_EMAIL=team@astralearnia.com

# ── App Configuration ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://astralearnia.com

# ── Optional: Analytics ───────────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=astralearnia.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
